# Copy to .env and adjust. No secrets are required to run the default (snapshot) mode.

# Data provider: "snapshot" (deterministic, offline) or "live" (real API calls)
TRAVEL_INTEL_DATA_MODE=snapshot

# Local LLM served by Ollama. "fake" makes the pipeline fully deterministic (used in tests).
TRAVEL_INTEL_LLM_PROVIDER=ollama
TRAVEL_INTEL_LLM_MODEL=llama3.1:8b
TRAVEL_INTEL_OLLAMA_HOST=http://localhost:11434
# The explanation call takes ~100 s on CPU with an 8B model. Below ~120 s it always times out.
TRAVEL_INTEL_LLM_TIMEOUT_S=180
